{
  "name": "agent-julia",
  "version": "0.2.0",
  "description": "One AI that knows you, in every Claude you use: a named persona and a memory you own, shared by Claude Code, Claude Desktop, claude.ai and the Claude mobile app. Plain markdown in git, served over MCP.",
  "author": "Paweł Gniadkowski (elniño) <el@elnino.pl>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-julia": "dist/index.js"
  },
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elninopl/agent-julia.git"
  },
  "bugs": {
    "url": "https://github.com/elninopl/agent-julia/issues"
  },
  "homepage": "https://github.com/elninopl/agent-julia#readme",
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:assets",
    "copy:assets": "node scripts/copy-assets.mjs",
    "dev": "tsx src/index.ts",
    "wizard": "tsx src/index.ts init",
    "serve": "tsx src/index.ts serve",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "check:names": "node scripts/check-names.mjs --tree",
    "hooks": "git config core.hooksPath .githooks",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.2.1",
    "franc-min": "^6.2.0",
    "js-yaml": "^4.3.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^3 || ^4"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "claude-desktop",
    "claude-ai",
    "memory",
    "ai-memory",
    "persona",
    "local-first",
    "markdown",
    "knowledge-base"
  ]
}
